@model List<(string NombreDisciplina, int Cantidad)>

@{
    ViewData["Title"] = "Cantidad por disciplina";
}

<h1>Cantidad de inscriptos por disciplina</h1>

@if (Model.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>Disciplina</th>
                <th>Cantidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NombreDisciplina</td>
                    <td>@item.Cantidad</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No hay mascotas registradas.</div>
}

<p>
    <a asp-action="Index" class="btn">Volver al Listado</a>
</p>

